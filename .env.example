# Copy to .env and fill in real values. NEVER commit .env (it is gitignored).

# ---- LLM ----
LLM_PROVIDER=ollama               # gemini | openai | ollama
# Gemini: free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_REQUESTS_PER_MINUTE=12      # free tier allows 15/min
# Put your key in .env only (never in code). Write it right after "=", no quotes or spaces.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m               # keep the model loaded between questions
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# ---- Embeddings ----
EMBEDDING_PROVIDER=local           # local | gemini | openai
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIM=768
# The refusal gate depends on the embedding model: 0.25 for local MiniLM (settings.yaml),
# 0.70 for gemini-embedding-2. Uncomment when EMBEDDING_PROVIDER=gemini.
# RETRIEVAL__SCORE_THRESHOLD=0.70
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Storage ----
CHROMA_DIR=./data/vectorstore
CHROMA_COLLECTION=academic_docs
RAW_DIR=./data/raw
DATABASE_URL=sqlite:///./data/app.db
MAX_UPLOAD_MB=50

# ---- API / UI ----
API_HOST=127.0.0.1
API_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
LOG_LEVEL=INFO
WARMUP_ON_STARTUP=true             # preload models in the background at API start
